# GitHub Linguist hints.
#
# The language bar counts bytes, and the generated dashboards each embed a
# ~4.8 MB Plotly bundle. Left unmarked they read as 99% HTML and bury the
# Python that actually builds the pipeline. These are build output of
# spark/gold_analytics.py, not hand-written source.
#
# linguist-generated also collapses these files in diffs, which is what you
# want for an 8.8 MB regenerated artefact.

docs/index.html                     linguist-generated=true
dashboards/executive_dashboard.html linguist-generated=true
dashboards/preview-*.png            linguist-generated=true

# Pipeline output: Bronze, Silver and Gold layers are regenerated by the
# Spark jobs, so keep their churn out of diffs too.
data/**                             linguist-generated=true
